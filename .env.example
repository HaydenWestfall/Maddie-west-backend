# Server
PORT=8081

# MongoDB - separate database from the Node backend's maddie-west-events DB,
# but can point at the same Mongo instance (see ../database/docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/rental-service

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MS=86400000

# Google OAuth (must match the client ID used by maddie-west-events-admin)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Coordinator seed (initial admin account, created on first startup)
COORDINATOR_SEED_EMAIL=admin@example.com
COORDINATOR_SEED_NAME=Admin Name

# Email (SMTP) - same pattern as madd-west-events-backend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com
COORDINATOR_NOTIFICATION_EMAIL=coordinator@maddiewestevents.com

# CORS - Angular dev server
CORS_ALLOWED_ORIGINS=http://localhost:4200
