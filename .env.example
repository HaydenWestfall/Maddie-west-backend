# Server
PORT=8081

# MongoDB - separate database from the Node backend's maddie-west-events DB,
# but can point at the same Mongo instance (see ../database/docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/rental-service

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MS=86400000

# Google OAuth (must match the client ID used by maddie-west-events-admin)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Coordinator seed (initial admin account, created on first startup)
COORDINATOR_SEED_EMAIL=admin@example.com
COORDINATOR_SEED_NAME=Admin Name

# Email (SMTP) - same pattern as madd-west-events-backend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=your-email@gmail.com
COORDINATOR_NOTIFICATION_EMAIL=coordinator@maddiewestevents.com

# CORS - Angular dev server
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Cloudflare R2 image storage (S3-compatible)
# R2_ACCOUNT_ID:       Cloudflare dashboard -> R2 -> "Account details" (the 32-char hex Account ID)
# R2_ACCESS_KEY_ID +   R2 -> "Manage R2 API Tokens" -> create a token with Object Read & Write,
# R2_SECRET_ACCESS_KEY   scoped to your bucket. It shows the key/secret pair once.
# R2_BUCKET:           maddie-west-rentals-dev for dev, maddie-west-rentals for prod
# R2_PUBLIC_BASE_URL:  the bucket's public URL. Enable "Public Development URL" on the bucket
#                      (Settings -> Public access) to get https://pub-<hash>.r2.dev, or use your
#                      connected custom domain. No trailing slash.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=maddie-west-rentals-dev
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
