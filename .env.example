# Server
PORT=8081

# MongoDB - separate database from the Node backend's maddie-west-events DB,
# but can point at the same Mongo instance (see ../database/docker-compose.yml)
MONGODB_URI=mongodb://localhost:27017/rental-service

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MS=86400000

# Google OAuth (must match the client ID used by maddie-west-events-admin)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Coordinator seed (initial admin account, created on first startup)
COORDINATOR_SEED_EMAIL=admin@example.com
COORDINATOR_SEED_NAME=Admin Name

# Email (SMTP) - sends via SMTP2GO's SMTP relay (same provider as the contact-api).
# Create a dedicated SMTP user in the SMTP2GO dashboard (Settings -> SMTP Users) for this
# backend. Use port 2525 instead of 587 if a host blocks 587. MAIL_FROM must be a verified
# sender/domain in SMTP2GO (maddiewestevents.com is already verified).
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=your-smtp2go-username
SMTP_PASS=your-smtp2go-password
MAIL_FROM=noreply@maddiewestevents.com
COORDINATOR_NOTIFICATION_EMAIL=coordinator@maddiewestevents.com

# Payment - Venmo handle used in the approval email's "Pay with Venmo" link.
# Enter the handle WITHOUT the leading @ (e.g. MaddieWestEvents).
VENMO_USERNAME=MaddieWestEvents

# Admin UI base URL - used to build the "Review this request" link in the coordinator email.
# No trailing slash. The link resolves to <base>/inquiries/<id>.
ADMIN_UI_BASE_URL=http://localhost:4200

# CORS - comma-separated. Include the Angular dev server, and (for the public contact form)
# the marketing site origins.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:5173,https://maddiewestevents.com,https://www.maddiewestevents.com

# Cloudflare R2 image storage (S3-compatible)
# R2_ACCOUNT_ID:       Cloudflare dashboard -> R2 -> "Account details" (the 32-char hex Account ID)
# R2_ACCESS_KEY_ID +   R2 -> "Manage R2 API Tokens" -> create a token with Object Read & Write,
# R2_SECRET_ACCESS_KEY   scoped to your bucket. It shows the key/secret pair once.
# R2_BUCKET:           maddie-west-rentals-dev for dev, maddie-west-rentals for prod
# R2_PUBLIC_BASE_URL:  the bucket's public URL. Enable "Public Development URL" on the bucket
#                      (Settings -> Public access) to get https://pub-<hash>.r2.dev, or use your
#                      connected custom domain. No trailing slash.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=maddie-west-rentals-dev
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
